# ==============================================================================
# Bait Clean — Environment Configuration
# ==============================================================================
# NEXT_PUBLIC_APP_URL: Base URL used for metadataBase, canonicals, sitemap, robots,
# OpenGraph, and JSON-LD structured data. Never include a trailing slash.
# Production:  https://baitclean.com
# Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NEXT_PUBLIC_ALLOW_INDEXING: Controls search engine indexing.
# Set to 'true' only in Vercel's Production environment.
# When 'false', all routes serve noindex, nofollow and robots.txt disallows all.
NEXT_PUBLIC_ALLOW_INDEXING=false
